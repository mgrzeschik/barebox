#
# Boot a raw zImage stored in the NAND "kernel" partition, root
# filesystem in the UBIFS volume "rootfs" of the "root" partition.
#
# Write the kernel from barebox with:
#   erase /dev/nand0.kernel.bb
#   cp /mnt/tftp/zImage /dev/nand0.kernel.bb

global.bootm.image=/dev/nand0.kernel.bb
global.linux.bootargs.dyn.root="ubi.mtd=root root=ubi0:rootfs rootfstype=ubifs rw"
