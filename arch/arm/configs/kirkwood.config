# SPDX-License-Identifier: GPL-2.0-only
#
# Only the Kirkwood boards of mvebu_defconfig:
#
#   make mvebu_defconfig kirkwood.config
#
# The Armada 370/XP/38x boards in mvebu_defconfig need DDR training code
# (arch/arm/boards/*/binary.0) that is not part of barebox; mvebu_defconfig
# skips their images if it is missing. Kirkwood needs no such firmware, so
# this configuration builds fewer images and treats missing firmware as error.

# CONFIG_MACH_GLOBALSCALE_MIRABOX is not set
# CONFIG_MACH_NETGEAR_RN104 is not set
# CONFIG_MACH_LENOVO_IX4_300D is not set
# CONFIG_MACH_MARVELL_ARMADA_XP_DB is not set
# CONFIG_MACH_MARVELL_ARMADA_XP_GP is not set
# CONFIG_MACH_NETGEAR_RN2120 is not set
# CONFIG_MACH_PLATHOME_OPENBLOCKS_AX3 is not set
# CONFIG_MACH_TURRIS_OMNIA is not set
# CONFIG_MACH_SOLIDRUN_CUBOX is not set
CONFIG_MISSING_FIRMWARE_ERROR=y
